{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinGlow",
  "version": "1.1.3",
  "identifier": "com.sober.windowsfonttuner2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WinGlow",
        "width": 1080,
        "height": 740,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "让 Windows 更合心意。",
    "longDescription": "调整字体、管理与美化右键菜单、开关桌面细节。提供自动备份、分类还原与 Windows 扫描修复。",
    "resources": {
      "../../FontPackages/harmonyos-sc/LICENSE.txt": "licenses/HarmonyOS-LICENSE.txt",
      "../../FontPackages/harmonyos-sc/SOURCE.txt": "licenses/HarmonyOS-SOURCE.txt",
      "../../FontPackages/source-han-sans-cn/LICENSE.txt": "licenses/SourceHan-LICENSE.txt",
      "../../FontPackages/source-han-sans-cn/SOURCE.txt": "licenses/SourceHan-SOURCE.txt",
      "../../FontPackages/pingfang-sc/NOTICE.txt": "licenses/PingFang-NOTICE.txt",
      "../../FontPackages/pingfang-sc/SOURCE.txt": "licenses/PingFang-SOURCE.txt",
      "../../LICENSE": "licenses/APP-LICENSE.txt",
      "../../licenses/Breeze-AGPL-3.0.txt": "licenses/Breeze-AGPL-3.0.txt",
      "../../licenses/THIRD-PARTY.txt": "licenses/THIRD-PARTY.txt",
      "../../docs/branding/icon-master.png": "branding/icon-master.png",
      "../../docs/branding/brand-source.json": "branding/brand-source.json",
      "../../docs/branding/README.md": "branding/README.md",
      "../../licenses/TranslucentTB-GPL-3.0.md": "licenses/TranslucentTB-GPL-3.0.md",
      "../../third-party/TranslucentTB/SOURCE.md": "licenses/TranslucentTB-SOURCE.md",
      "../../third-party/Windhawk/SOURCE.md": "licenses/Windhawk-SOURCE.md",
      "../../licenses/Windhawk-GPL-3.0.txt": "licenses/Windhawk-GPL-3.0.txt",
      "../../licenses/Windhawk-LLVM-LICENSE.txt": "licenses/Windhawk-LLVM-LICENSE.txt",
      "../../licenses/ContextMenuManager-Dictionary-GPL-3.0.txt": "licenses/ContextMenuManager-Dictionary-GPL-3.0.txt",
      "../../third-party/ContextMenuManager/SOURCE.md": "licenses/ContextMenuManager-Dictionary-SOURCE.md",
      "../../third-party/ContextMenuManager/GuidInfosDic.ini": "licenses/ContextMenuManager-GuidInfosDic.ini"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "WinGlow",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExQkY0MjQ1M0VENDZCNzQKUldSMGE5UStSVUsvRVNMaVUwUmV5N1k3MDhZWldvODZkUVZIL3pDblMvU0ZKeTBkYWE0cndJWDIK",
      "endpoints": [
        "https://github.com/soberbw-hash/WinGlow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
