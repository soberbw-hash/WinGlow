{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows 微调",
  "version": "3.0.0",
  "identifier": "com.sober.windowsfonttuner2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Windows 微调",
        "width": 1080,
        "height": 740,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "让 Windows 更合心意。",
    "longDescription": "调整字体、右键菜单与界面细节。当前版本提供字体调整与自动备份恢复。",
    "resources": {
      "../../FontPackages/harmonyos-sc/LICENSE.txt": "licenses/HarmonyOS-LICENSE.txt",
      "../../FontPackages/harmonyos-sc/SOURCE.txt": "licenses/HarmonyOS-SOURCE.txt",
      "../../FontPackages/source-han-sans-cn/LICENSE.txt": "licenses/SourceHan-LICENSE.txt",
      "../../FontPackages/source-han-sans-cn/SOURCE.txt": "licenses/SourceHan-SOURCE.txt",
      "../../LICENSE": "licenses/APP-LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
